# Copy to .env. Mock mode is the default and needs no keys.
# NOTE: rate limits and base URLs for the live Monzo / Trading212 APIs are UNVERIFIED
# (see docs/PLAN.md section 9). Do not rely on them until confirmed.
MONZO_MODE=mock
T212_MODE=mock
MONZO_ACCESS_TOKEN=
MONZO_BASE_URL=https://api.monzo.com
T212_API_KEY=
# REQUIRED with the key: Trading212 uses HTTP Basic auth (key:secret). Verified against
# docs.trading212.com (Oct 2026). Demo base URL: https://demo.trading212.com/api/v0
T212_API_SECRET=
T212_BASE_URL=https://live.trading212.com/api/v0
SOURCE_TIMEOUT_SECONDS=5
SOURCE_MAX_RETRIES=2
ISA_ALLOWANCE_PENCE=2000000
MOCK_PERSONA=steady_saver
ANTHROPIC_API_KEY=
EXPLAINER_MODEL=claude-sonnet-5-5
CACHE_DIR=data/cache
# Credentials pasted or connected in the UI can be remembered in <CREDENTIALS_DIR>/credentials.json
# (mode 0600, gitignored). The env vars above are only a fallback when nothing is stored.
CREDENTIALS_DIR=data/private
# Monzo OAuth (optional). Register the redirect URI in the Monzo developer portal.
# MONZO_AUTH_URL and MONZO_TOKEN_URL match docs.monzo.com. Use a Confidential client so Monzo issues
# refresh tokens. You must also approve access in the Monzo app after authorising.
MONZO_CLIENT_ID=
MONZO_CLIENT_SECRET=
MONZO_REDIRECT_URI=http://localhost:8000/v1/connect/monzo/callback
MONZO_AUTH_URL=https://auth.monzo.com/
MONZO_TOKEN_URL=https://api.monzo.com/oauth2/token
# Time budget (seconds) for importing your full Monzo history right after connecting. Monzo only
# shares the last 90 days once 5 minutes have passed since authentication.
MONZO_INITIAL_SYNC_TIMEOUT_SECONDS=60
