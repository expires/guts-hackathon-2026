# Copy to .env and fill in. Never commit .env.
# A missing key makes that adapter serve labelled MOCK data (status "mock").

# --- Service ---
APP_ENV=dev
JWT_SECRET=change-me-dev-only
DATABASE_URL=postgresql+asyncpg://lifeline:lifeline@postgres:5432/lifeline
REDIS_URL=redis://redis:6379/0
PUBLIC_BASE_URL=http://localhost:8000
RATE_LIMIT_PER_MINUTE=120

# --- Data refresh (optional; defaults shown) ---
DATA_OFFLINE=0
DATA_REFRESH_INTERVAL_SECONDS=21600
MACRO_TABLE_TTL_SECONDS=3600

# --- Free-key sources ---
# Alias names also accepted (canonical name wins): COMPANIES_HOUSE_API_KEY, EPC_API_TOKEN,
# STATXPLORE_API_KEY, DVLA_VES_API_KEY, TRUELAYER_CLIENT_ID, TRUELAYER_CLIENT_SECRET, TRUELAYER_REDIRECT_URI.
# Companies House: basic auth, key as username, blank password
COMPANIES_HOUSE_KEY=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
DVLA_KEY=
DVSA_MOT_KEY=
# DVSA MOT History API also needs an OAuth bearer token
DVSA_MOT_TOKEN=
# Stat-Xplore: sent as the APIKey header
DWP_STATXPLORE_KEY=
# News context for Life feed and Ask Penny (ADR 0030)
GUARDIAN_API_KEY=
# EPC: bearer token (get-energy-performance-data service)
EPC_KEY=

# --- Open Banking sandbox (TrueLayer) ---
OB_PROVIDER=truelayer
OB_ENV=sandbox
OB_AUTH_URL=https://auth.truelayer-sandbox.com
OB_API_URL=https://api.truelayer-sandbox.com
OB_CLIENT_ID=
OB_CLIENT_SECRET=
OB_REDIRECT_URI=http://localhost:8000/v1/bank/callback

# --- LLM (flavour text only) ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_TIMEOUT_SECONDS=12
CHAT_TIMEOUT_SECONDS=12
# Kill switch: 0 = deterministic templates only
LLM_ENABLED=1

# Fernet key: encrypts bank tokens and user finance snapshots at rest (ADR 0028)
TOKEN_ENCRYPTION_KEY=

# --- Sign in with Apple ---
APPLE_BUNDLE_ID=com.lifeline.app

# --- Personal accounts: Monzo + Trading212 (read-only, your own accounts) ---
# Monzo OAuth: create a Confidential client at developers.monzo.com and register MONZO_REDIRECT_URI on it exactly
# (PUBLIC_BASE_URL + /v1/bank/callback). Approve access in the Monzo app after signing in.
# Monzo only shares full history in the first 5 minutes after sign-in; after that, 90 days.
MONZO_CLIENT_ID=
MONZO_CLIENT_SECRET=
MONZO_REDIRECT_URI=http://localhost:8000/v1/bank/callback
# Trading212: key + secret pair from the Trading212 app (HTTP Basic auth). Dev-only fallback for your own account.
T212_API_KEY=
T212_API_SECRET=
# Encrypted store (TOKEN_ENCRYPTION_KEY) of connected-account tokens and imported history. Gitignored.
CREDENTIALS_DIR=data/private
