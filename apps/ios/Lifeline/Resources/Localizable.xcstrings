    "Open Life and tap Play yourself to add your job, pay and savings. Then your money shows here." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre Vida y toca Juega como tú para añadir tu trabajo, sueldo y ahorros. Luego tu dinero aparece aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvre Vie et touche Joue ton propre rôle pour ajouter ton emploi, ton salaire et ton épargne. Ton argent s'affichera ensuite ici."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ज़िंदगी खोलें और अपनी नौकरी, कमाई और बचत जोड़ने के लिए ख़ुद खेलें दबाएँ। फिर आपका पैसा यहाँ दिखेगा।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apri Vita e tocca Gioca come te per aggiungere lavoro, stipendio e risparmi. Poi i tuoi soldi appaiono qui."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जीवन खोल्नुहोस् र आफ्नो काम, तलब र बचत थप्न आफैं खेल्नुहोस् थिच्नुहोस्। त्यसपछि तपाईंको पैसा यहाँ देखिन्छ।"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abra Vida e toque em Jogue como você para adicionar seu trabalho, salário e poupança. Depois seu dinheiro aparece aqui."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开「人生」，点「扮演自己」，添加你的工作、收入和存款。之后你的钱会显示在这里。"
          }
        }
      }
    },
