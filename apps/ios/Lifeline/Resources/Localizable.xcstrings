    "Turn on at least one way money arrives and enter the amount." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa al menos una forma en que llega el dinero e introduce la cantidad."
          }
        },
        "fr" : {
          "stringUnit" : {
