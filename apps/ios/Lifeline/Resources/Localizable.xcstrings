    "Your most expensive week was %@. At that pace, your money would not last to %@." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your most expensive week was %1$@. At that pace, your money would not last to %2$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu semana más cara fue de %1$@. A ese ritmo, tu dinero no llegaría al %2$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta semaine la plus chère a coûté %1$@. À ce rythme, ton argent ne tiendrait pas jusqu'au %2$@."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपका सबसे महँगा हफ़्ता %1$@ का था। उस रफ़्तार से आपका पैसा %2$@ तक नहीं चलेगा।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua settimana più cara è stata di %1$@. A quel ritmo, i soldi non durerebbero fino al %2$@."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तपाईंको सबैभन्दा महँगो हप्ता %1$@ को थियो। त्यो गतिमा तपाईंको पैसा %2$@ सम्म टिक्दैन।"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua semana mais cara foi de %1$@. Nesse ritmo, seu dinheiro não duraria até %2$@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你最贵的一周花了 %1$@。按那个速度，你的钱撑不到 %2$@。"
          }
        }
      }
    },
    "Your most expensive week was %@. Even at that pace, you still make it to %@." : {
      "localizations" : {
