    "This removes your account and every record we hold: lives, plan, guesses and money data. You cannot undo it." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto elimina tu cuenta y todos los registros que guardamos: vidas, plan, estimaciones y datos de dinero. No se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela supprime ton compte et toutes les données que nous conservons : vies, plan, estimations et données d'argent. Impossible d'annuler."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इससे आपका खाता और हमारे पास रखा हर रिकॉर्ड मिट जाएगा: ज़िंदगियाँ, प्लान, अनुमान और पैसे का डेटा। इसे वापस नहीं किया जा सकता।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo elimina il tuo account e ogni dato che conserviamo: vite, piano, stime e dati sui soldi. Non si può annullare."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यसले तपाईंको खाता र हामीसँग भएका सबै रेकर्ड मेटाउँछ: जीवन, योजना, अनुमान र पैसाको डेटा। यो फिर्ता गर्न सकिँदैन।"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isto exclui sua conta e todos os registros que guardamos: vidas, plano, palpites e dados de dinheiro. Não dá para desfazer."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这会删除你的账户以及我们保存的全部记录：人生、计划、猜测和资金数据。无法撤销。"
          }
        }
      }
    },
