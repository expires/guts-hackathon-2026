            "value" : "Active au moins une source de revenus et saisis le montant."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पैसा आने का कम से कम एक तरीका चालू करें और रकम भरें।"
          }
        },
        "it" : {
