    "Yes, for about 4 months. Your savings cover your bills and mortgage until April." : {
      "extractionState" : "stale",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sí, durante unos 4 meses. Tus ahorros cubren tus facturas y la hipoteca hasta abril."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oui, pendant environ 4 mois. Ton épargne couvre tes factures et ton crédit immobilier jusqu'en avril."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हाँ, लगभग 4 महीने तक। आपकी बचत अप्रैल तक आपके बिल और होम लोन चुका देती है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sì, per circa 4 mesi. I tuoi risparmi coprono bollette e mutuo fino ad aprile."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हो, करिब 4 महिनासम्म। तपाईंको बचतले अप्रिलसम्म बिल र घर ऋण धान्छ।"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sim, por cerca de 4 meses. Sua poupança cobre suas contas e o financiamento até abril."
          }
