    "Hi, I'm Penny. Ask me anything about student money. I can't see your numbers yet." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hola, soy Penny. Pregúntame lo que quieras sobre el dinero de estudiante. Todavía no veo tus números."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salut, je suis Penny. Pose-moi n'importe quelle question sur l'argent des étudiants. Je ne vois pas encore tes chiffres."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नमस्ते, मैं Penny हूँ। छात्रों के पैसे के बारे में मुझसे कुछ भी पूछें। मैं अभी आपके आँकड़े नहीं देख सकती।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciao, sono Penny. Chiedimi qualsiasi cosa sui soldi da studente. Non vedo ancora i tuoi numeri."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नमस्ते, म Penny हुँ। विद्यार्थीको पैसाबारे मलाई जे पनि सोध्नुहोस्। म अहिले तपाईंका अंक देख्न सक्दिनँ।"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oi, eu sou a Penny. Pergunte qualquer coisa sobre dinheiro de estudante. Ainda não vejo seus números."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你好，我是 Penny。关于学生理财，什么都可以问我。我还看不到你的数字。"
          }
        }
      }
    },
