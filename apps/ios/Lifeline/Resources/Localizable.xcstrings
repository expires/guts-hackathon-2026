    "The game cannot start a life with these details. The character must be at least 16 in the start year. Check the details and try again." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El juego no puede empezar una vida con estos datos. El personaje debe tener al menos 16 años en el año de inicio. Revisa los datos e inténtalo otra vez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le jeu ne peut pas lancer une vie avec ces informations. Le personnage doit avoir au moins 16 ans l'année de départ. Vérifie les informations et réessaie."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इन जानकारियों से खेल ज़िंदगी शुरू नहीं कर सकता। शुरुआती साल में किरदार की उम्र कम से कम 16 होनी चाहिए। जानकारी जाँचें और फिर कोशिश करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il gioco non può iniziare una vita con questi dati. Il personaggio deve avere almeno 16 anni nell'anno di inizio. Controlla i dati e riprova."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यी विवरणले खेलले जीवन सुरु गर्न सक्दैन। सुरु वर्षमा पात्रको उमेर कम्तीमा 16 हुनुपर्छ। विवरण जाँचेर फेरि प्रयास गर्नुहोस्।"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O jogo não pode começar uma vida com esses dados. O personagem precisa ter pelo menos 16 anos no ano de início. Confira os dados e tente de novo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "游戏无法用这些信息开始人生。角色在起始年份必须至少 16 岁。请检查后重试。"
          }
        }
      }
