    "Live a life from 18. Make the money choices. See where they lead." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vive una vida desde los 18. Toma las decisiones de dinero. Mira a dónde te llevan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vis une vie à partir de 18 ans. Fais les choix d'argent. Vois où ils mènent."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "18 की उम्र से एक ज़िंदगी जिएँ। पैसे के फ़ैसले लें। देखें वे कहाँ ले जाते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vivi una vita dai 18 anni. Fai le scelte sui soldi. Guarda dove portano."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "18 वर्षदेखि एउटा जीवन बाँच्नुहोस्। पैसाका छनोट गर्नुहोस्। तिनले कहाँ पुर्याउँछन् हेर्नुहोस्।"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viva uma vida a partir dos 18. Faça as escolhas de dinheiro. Veja aonde elas levam."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从 18 岁开始过一段人生。做出用钱的选择，看看会走向哪里。"
          }
        }
      }
    },
    "Live a whole life with real UK numbers. Every year you choose what to do with your money." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vive una vida entera con números reales del Reino Unido. Cada año eliges qué hacer con tu dinero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vis toute une vie avec de vrais chiffres britanniques. Chaque année, tu choisis quoi faire de ton argent."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ब्रिटेन के असली आँकड़ों के साथ पूरी ज़िंदगी जिएँ। हर साल आप तय करते हैं कि अपने पैसे का क्या करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vivi una vita intera con numeri reali del Regno Unito. Ogni anno scegli cosa fare con i tuoi soldi."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बेलायतका वास्तविक अंकसँग पूरा जीवन बाँच्नुहोस्। हरेक वर्ष आफ्नो पैसाले के गर्ने तपाईं छान्नुहुन्छ।"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viva uma vida inteira com números reais do Reino Unido. Todo ano você escolhe o que fazer com seu dinheiro."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
