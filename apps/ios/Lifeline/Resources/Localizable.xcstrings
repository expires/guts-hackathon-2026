    "Four of you. Same life. One choice is different." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sois cuatro. Misma vida. Solo cambia una decisión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous êtes quatre. Même vie. Un seul choix change."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप चार हैं। वही ज़िंदगी। सिर्फ़ एक चुनाव अलग।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siete in quattro. Stessa vita. Cambia una sola scelta."
