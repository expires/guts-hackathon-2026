    "Your answers stay on our server for this game only. No bank details are needed." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus respuestas se quedan en nuestro servidor solo para este juego. No hacen falta datos bancarios."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tes réponses restent sur notre serveur pour ce jeu uniquement. Aucune coordonnée bancaire n'est nécessaire."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके जवाब सिर्फ़ इस खेल के लिए हमारे सर्वर पर रहते हैं। बैंक की कोई जानकारी नहीं चाहिए।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le tue risposte restano sul nostro server solo per questo gioco. Non servono dati bancari."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तपाईंका उत्तर यो खेलका लागि मात्र हाम्रो सर्भरमा रहन्छन्। बैंक विवरण चाहिँदैन।"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suas respostas ficam no nosso servidor só para este jogo. Não precisa de dados bancários."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的回答只为这个游戏保存在我们的服务器上。不需要银行信息。"
          }
        }
      }
    },
