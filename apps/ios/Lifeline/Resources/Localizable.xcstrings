    "Ask Penny anything about money or student life. She answers in a sentence or two." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pregunta a Penny lo que quieras sobre dinero o vida de estudiante. Responde en una o dos frases."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pose à Penny n'importe quelle question sur l'argent ou la vie étudiante. Elle répond en une ou deux phrases."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पैसे या छात्र जीवन के बारे में Penny से कुछ भी पूछें। वह एक-दो वाक्यों में जवाब देती है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiedi a Penny qualsiasi cosa su soldi o vita da studente. Risponde in una o due frasi."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पैसा वा विद्यार्थी जीवनबारे Penny लाई जे पनि सोध्नुहोस्। उनी एक-दुई वाक्यमा जवाफ दिन्छिन्।"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pergunte à Penny qualquer coisa sobre dinheiro ou vida de estudante. Ela responde em uma ou duas frases."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关于钱或学生生活，什么都可以问 Penny。她会用一两句话回答。"
          }
        }
      }
    },
    "Ask Penny what this means" : {
      "extractionState" : "manual",
      "localizations" : {
