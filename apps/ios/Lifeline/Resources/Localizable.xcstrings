    "your first payslip, tax and loan repayments decide what you take home." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tu primera nómina, los impuestos y la devolución del préstamo deciden lo que te llevas a casa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ta première fiche de paie, les impôts et le remboursement du prêt décident de ce que tu touches vraiment."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपकी पहली पेस्लिप, टैक्स और लोन की वापसी तय करते हैं कि आप घर कितना ले जाते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "la tua prima busta paga, le tasse e il rimborso del prestito decidono quanto porti a casa."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तपाईंको पहिलो तलब पर्ची, कर र ऋण भुक्तानीले घर कति लैजानुहुन्छ भन्ने तय गर्छन्।"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "o teu primeiro recibo de vencimento, os impostos e o reembolso do empréstimo decidem o que levas para casa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的第一张工资单、税和还贷决定你实际到手多少钱。"
          }
        }
      }
    },
