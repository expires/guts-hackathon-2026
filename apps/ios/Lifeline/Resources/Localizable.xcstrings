    "The app shows the engine's template text. A number that fails the check is never shown." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La app muestra el texto de plantilla del motor. Un número que no pasa la comprobación nunca se muestra."
