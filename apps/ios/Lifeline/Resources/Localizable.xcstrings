    "This clears the demo accounts and rooms, then starts onboarding." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto borra las cuentas y salas de demo y luego inicia la bienvenida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela efface les comptes et salles de démo, puis relance l'accueil."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इससे डेमो खाते और रूम मिट जाएँगे, फिर शुरुआती सेटअप शुरू होगा।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo cancella gli account e le stanze demo, poi avvia l'introduzione."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यसले डेमो खाता र रूमहरू मेटाउँछ, त्यसपछि सुरुको सेटअप सुरु गर्छ।"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isto apaga as contas e salas de demonstração e depois inicia a introdução."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这会清除演示账户和房间，然后重新开始引导。"
          }
        }
      }
    },
    "This clears your lives, plan, guesses and money data. Your account stays." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto borra tus vidas, plan, estimaciones y datos de dinero. Tu cuenta se mantiene."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela efface tes vies, ton plan, tes estimations et tes données d'argent. Ton compte reste."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इससे आपकी ज़िंदगियाँ, प्लान, अनुमान और पैसे का डेटा मिट जाएगा। आपका खाता बना रहेगा।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo cancella vite, piano, stime e dati sui soldi. Il tuo account resta."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यसले तपाईंका जीवन, योजना, अनुमान र पैसाको डेटा मेटाउँछ। तपाईंको खाता रहन्छ।"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isto apaga suas vidas, plano, palpites e dados de dinheiro. Sua conta continua."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这会清除你的人生、计划、猜测和资金数据。账户会保留。"
          }
        }
      }
    },
    "This device has no camera. Type the room code instead." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este dispositivo no tiene cámara. Escribe el código de la sala."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet appareil n'a pas de caméra. Tape plutôt le code de la salle."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस डिवाइस में कैमरा नहीं है। इसके बजाय रूम कोड लिखें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo dispositivo non ha la fotocamera. Scrivi invece il codice della stanza."
          }
        },
        "ne" : {
          "stringUnit" : {
