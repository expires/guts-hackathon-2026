    "one overdraft fee, debt or scam can cost more than a month of food shopping." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "una sola comisión de descubierto, una deuda o una estafa puede costar más que un mes de compra de comida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "un seul frais de découvert, une dette ou une arnaque peut coûter plus qu'un mois de courses."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक ओवरड्राफ्ट फ़ीस, कर्ज़ या धोखा एक महीने की राशन ख़रीद से ज़्यादा महँगा पड़ सकता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "una sola commissione di scoperto, un debito o una truffa può costare più di un mese di spesa."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एउटा ओभरड्राफ्ट शुल्क, ऋण वा ठगीले एक महिनाको खानाको किनमेलभन्दा बढी खर्च गराउन सक्छ।"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "uma só taxa de descoberto, uma dívida ou uma burla pode custar mais do que um mês de compras de comida."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一次透支费、一笔债务或一次诈骗，可能比一个月的买菜钱还多。"
          }
        }
      }
    },
