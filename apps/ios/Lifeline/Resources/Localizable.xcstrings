          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ensemble : l'action prend tout cela en compte à la fois, ce qui vaut mieux qu'une seule source."
          }
        },
        "hi" : {
          "stringUnit" : {
