    "The app shows the engine's template text. A number that fails the check is never shown." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La app muestra el texto de plantilla del motor. Un número que no pasa la comprobación nunca se muestra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'app affiche le texte modèle du moteur. Un chiffre qui échoue à la vérification n'est jamais affiché."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐप इंजन का तय टेक्स्ट दिखाता है। जाँच में फ़ेल हुआ आँकड़ा कभी नहीं दिखाया जाता।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'app mostra il testo modello del motore. Un numero che non supera il controllo non viene mai mostrato."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
