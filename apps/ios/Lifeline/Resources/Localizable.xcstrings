    "interest rates and prices change what your rent, savings and shopping cost." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "los tipos de interés y los precios cambian lo que cuestan tu alquiler, tus ahorros y tu compra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "les taux d'intérêt et les prix changent le coût de ton loyer, de ton épargne et de tes courses."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ब्याज दरें और कीमतें आपके किराए, बचत और ख़रीदारी की लागत बदलती हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tassi di interesse e prezzi cambiano quanto costano affitto, risparmi e spesa."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ब्याजदर र मूल्यले तपाईंको भाडा, बचत र किनमेलको लागत बदल्छन्।"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "as taxas de juro e os preços mudam o custo da tua renda, das tuas poupanças e das tuas compras."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "利率和物价会改变你的房租、储蓄和购物成本。"
          }
        }
      }
    },
    "loans, bursaries, rent and bills set how much you have to live on each term." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "los préstamos, las becas, el alquiler y las facturas fijan cuánto tienes para vivir cada trimestre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "les prêts, les bourses, le loyer et les factures fixent ce qu'il te reste pour vivre chaque trimestre."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लोन, बर्सरी, किराया और बिल तय करते हैं कि हर टर्म में आपके पास जीने के लिए कितना है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "prestiti, borse di studio, affitto e bollette decidono quanto hai per vivere ogni trimestre."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऋण, छात्रवृत्ति, भाडा र बिलले हरेक टर्ममा बाँच्न कति पैसा हुन्छ भन्ने तय गर्छन्।"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "os empréstimos, as bolsas, a renda e as contas definem quanto tens para viver em cada período."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "贷款、助学金、房租和账单决定你每学期有多少钱生活。"
          }
        }
      }
    },
    "money you put aside now earns interest and gives you a cushion later." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "el dinero que apartas ahora gana intereses y te da un colchón más adelante."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "l'argent que tu mets de côté maintenant rapporte des intérêts et te protège plus tard."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अभी बचाया गया पैसा ब्याज कमाता है और बाद में आपको सहारा देता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "i soldi che metti da parte ora fruttano interessi e ti danno un cuscinetto più avanti."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अहिले छुट्याएको पैसाले ब्याज कमाउँछ र पछि तपाईंलाई सहारा दिन्छ।"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "o dinheiro que pões de lado agora rende juros e dá-te uma almofada mais tarde."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "现在存下的钱会赚利息，以后给你一份保障。"
          }
        }
      }
    },
