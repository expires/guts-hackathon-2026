    "Each is a made-up student with 3 months of payments. Their Next Move is worked out live." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada uno es un estudiante inventado con 3 meses de pagos. Su próximo paso se calcula en directo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chacun est un étudiant fictif avec 3 mois de paiements. Sa prochaine action est calculée en direct."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर एक काल्पनिक छात्र है, जिसके 3 महीने के भुगतान हैं। उसका अगला कदम लाइव निकाला जाता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ognuno è uno studente inventato con 3 mesi di pagamenti. La sua prossima mossa viene calcolata dal vivo."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हरेक 3 महिनाको भुक्तानी भएको काल्पनिक विद्यार्थी हो। उसको अर्को कदम लाइभ निकालिन्छ।"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada um é um estudante fictício com 3 meses de pagamentos. O próximo passo dele é calculado ao vivo."
