    "small everyday choices decide whether your money lasts until your next payment." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "las pequeñas decisiones diarias deciden si tu dinero dura hasta tu próximo pago."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "les petits choix de tous les jours décident si ton argent tient jusqu'au prochain versement."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "रोज़ के छोटे फ़ैसले तय करते हैं कि आपका पैसा अगले भुगतान तक चलेगा या नहीं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "le piccole scelte di ogni giorno decidono se i tuoi soldi durano fino al prossimo pagamento."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दैनिक साना निर्णयले तपाईंको पैसा अर्को भुक्तानीसम्म पुग्छ कि पुग्दैन भन्ने तय गर्छन्।"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "as pequenas escolhas do dia a dia decidem se o teu dinheiro dura até ao próximo pagamento."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日常的小选择决定你的钱能否撑到下一笔收入。"
          }
        }
      }
    },
