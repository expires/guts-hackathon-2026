    "Your biggest cost after rent and bills. Spending less here helps most." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu mayor gasto después del alquiler y las facturas. Gastar menos aquí es lo que más ayuda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta plus grosse dépense après le loyer et les factures. Dépenser moins ici aide le plus."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "किराए और बिलों के बाद आपका सबसे बड़ा खर्च। यहाँ कम खर्च करने से सबसे ज़्यादा मदद मिलती है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua spesa più grande dopo affitto e bollette. Spendere meno qui aiuta di più."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "भाडा र बिलपछि तपाईंको सबैभन्दा ठूलो खर्च। यहाँ कम खर्च गर्दा सबैभन्दा बढी मद्दत हुन्छ।"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu maior gasto depois do aluguel e das contas. Gastar menos aqui é o que mais ajuda."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "除房租和账单外你最大的开销。在这里少花最有帮助。"
          }
        }
      }
    },
