          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इन जानकारियों से खेल ज़िंदगी शुरू नहीं कर सकता। शुरुआती साल में किरदार की उम्र कम से कम 16 होनी चाहिए। जानकारी जाँचें और फिर कोशिश करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il gioco non può iniziare una vita con questi dati. Il personaggio deve avere almeno 16 anni nell'anno di inizio. Controlla i dati e riprova."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यी विवरणले खेलले जीवन सुरु गर्न सक्दैन। सुरु वर्षमा पात्रको उमेर कम्तीमा 16 हुनुपर्छ। विवरण जाँचेर फेरि प्रयास गर्नुहोस्।"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O jogo não pode começar uma vida com esses dados. O personagem precisa ter pelo menos 16 anos no ano de início. Confira os dados e tente de novo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
