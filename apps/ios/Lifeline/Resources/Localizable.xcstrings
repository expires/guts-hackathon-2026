    "Ask me about your money, or anything about student life. When I use your numbers, I check every one." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pregúntame sobre tu dinero o sobre la vida de estudiante. Cuando uso tus números, los compruebo todos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pose-moi des questions sur ton argent ou sur la vie étudiante. Quand j'utilise tes chiffres, je les vérifie tous."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मुझसे अपने पैसे या छात्र जीवन के बारे में कुछ भी पूछें। जब मैं आपके आँकड़े इस्तेमाल करती हूँ, तो हर एक की जाँच करती हूँ।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiedimi dei tuoi soldi o di qualsiasi cosa sulla vita da studente. Quando uso i tuoi numeri, li controllo tutti."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मलाई आफ्नो पैसा वा विद्यार्थी जीवनबारे जे पनि सोध्नुहोस्। तपाईंका अंक प्रयोग गर्दा म हरेक जाँच्छु।"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pergunte sobre seu dinheiro ou qualquer coisa da vida de estudante. Quando uso seus números, confiro cada um."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "问我关于你的钱或学生生活的任何问题。用到你的数字时，我会逐一核对。"
          }
        }
      }
    },
